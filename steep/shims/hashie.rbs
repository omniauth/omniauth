# Additions to the hashie types from gem_rbs_collection, which only
# declare the class hierarchy. For Steep only; not shipped with the gem.
module Hashie
  class Mash < ::Hashie::Hash
    def self.disable_warnings: (*Symbol method_keys) -> void

    def initialize: (?::Hash[untyped, untyped]? source_hash, ?untyped default) ?{ (Mash, untyped) -> untyped } -> void

    def deep_merge!: (::Hash[untyped, untyped] other_hash) -> self

    # These return a new instance of the same class.
    def slice: (*untyped keys) -> self
    def except: (*untyped keys) -> self
    def select: () { (untyped, untyped) -> boolish } -> self
    def reject: () { (untyped, untyped) -> boolish } -> self
    def merge: (*::Hash[untyped, untyped] others) -> self

    def regular_writer: (untyped key, untyped value) -> untyped

    def method_missing: (Symbol method_name, *untyped args) ?{ (*untyped) -> untyped } -> untyped
  end
end
